# ============================================
# AI Model Deployer 配置文件
# ============================================

# Docker Registry Configuration
# -------------------------------------------
# 构建完成后镜像会推送到内置 Registry: 10.10.25.69:5000/ai-models/ai-model:<build_id>
DOCKER_REGISTRY_URL=10.10.25.69:5000/ai-models
# 后端 Docker daemon 推送地址。localhost:5000 可避免修改宿主机 Docker insecure registry。
DOCKER_REGISTRY_PUSH_URL=localhost:5000/ai-models
# 内置 registry:2 默认无认证；使用外部私有仓库时再填写账号密码
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Kubernetes Configuration
# -------------------------------------------
# K8s 配置文件路径
K8S_CONFIG_PATH=/root/.kube/config

# 默认命名空间
K8S_NAMESPACE=default

# 内置 registry:2 默认无认证，不需要 imagePullSecret
K8S_IMAGE_PULL_SECRET_NAME=

# NFS 挂载
# -------------------------------------------
# 默认会优先通过 showmount -e <管理节点> 自动发现导出目录。
# 如需覆盖，可直接填写以下值。
K8S_NFS_SHOWMOUNT_HOST=
K8S_NFS_SERVER=
K8S_NFS_EXPORT_ROOT=
K8S_NFS_BROWSE_ROOT=

# Model Storage
# -------------------------------------------
MODEL_STORAGE_PATH=./data/models
BUILD_CONTEXT_PATH=./data/builds

# ============================================
# 使用说明
# ============================================
# 
# 构建流程：
#    - 在页面上点击"构建"
#    - 系统自动构建 Docker 镜像
#    - 自动推送到内置 Registry：10.10.25.69:5000/ai-models
#    - 然后在页面上创建部署
#
# 注意：
#    - 后端宿主机和 K8s 节点必须能访问 10.10.25.69:5000
#    - 这是 HTTP registry，Docker/containerd 需要将 10.10.25.69:5000 配置为 insecure registry
#
# ============================================
