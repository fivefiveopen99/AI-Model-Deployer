# ============================================
# AI Model Deployer 配置文件
# ============================================

# Docker Configuration
# -------------------------------------------
# 本地镜像导出路径（构建完成后，tar 文件将保存在此目录）
LOCAL_IMAGE_PATH=./data/images

# 私有镜像仓库地址
DOCKER_REGISTRY_URL=10.10.25.69:5000/ai-models

# 构建节点实际 push 使用的仓库地址
DOCKER_REGISTRY_PUSH_URL=localhost:5000/ai-models

# 如仓库需要认证，填写用户名密码；内置 registry 可留空
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Kubernetes Configuration
# -------------------------------------------
# K8s 配置文件路径
K8S_CONFIG_PATH=/root/.kube/config

# 默认命名空间
K8S_NAMESPACE=default

# SSH 配置（用于自动分发镜像到 K8s 节点）
# SSH 用户名（默认 root）
K8S_SSH_USER=root

# SSH 私钥路径（可选，如果不设置则使用默认密钥）
# K8S_SSH_KEY_PATH=/root/.ssh/id_rsa

# Model Storage
# -------------------------------------------
MODEL_STORAGE_PATH=./data/models
BUILD_CONTEXT_PATH=./data/builds

# ============================================
# 使用说明
# ============================================
# 
# 构建流程：
#    - 在页面上点击"构建"
#    - 可选择在本机或指定 K8s 工作节点执行 docker build
#    - 构建完成后自动 push 到私有仓库
#    - 然后在页面上创建部署
#
# 注意：
#    - 远端构建节点需要安装 docker，并能访问私有仓库
#    - 需要确保 SSH 免密登录到 K8s 节点已配置
#    - 或者设置 K8S_SSH_KEY_PATH 指定私钥路径
#
# ============================================
